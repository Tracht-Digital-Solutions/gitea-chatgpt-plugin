# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
GITEA_MCP_VERSION=0.3.2 # x-release-please-version
PUBLIC_URL=https://mcp.example.org
PORT=3000
DATABASE_PATH=data/gitea.sqlite
OAUTH_ISSUER=https://auth.example.org/realms/gitea
OAUTH_AUDIENCE=https://mcp.example.org/mcp
OAUTH_JWKS_URL=https://auth.example.org/realms/gitea/protocol/openid-connect/certs
OAUTH_AUTHORIZATION_URL=https://auth.example.org/realms/gitea/protocol/openid-connect/auth
OAUTH_TOKEN_URL=https://auth.example.org/realms/gitea/protocol/openid-connect/token
PORTAL_CLIENT_ID=gitea-portal
# Optional operator presets (internal servers or registered Gitea OAuth clients).
# Users can connect their own public HTTPS server through the ChatGPT setup link.
# GITEA_INSTANCES=[{"id":"my-server","url":"https://YOUR-GITEA-HOST"}]
GITEA_INSTANCES=[]
# End users can connect public Gitea servers through the ChatGPT setup link.
# Private-network exceptions apply only to operator-configured instances.
ALLOW_USER_SERVERS=true
# Empty = public unicast addresses only. Explicit CIDRs allow trusted internal deployments.
ALLOWED_PRIVATE_CIDRS=
