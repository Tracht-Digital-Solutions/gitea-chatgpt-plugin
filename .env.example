# Kopie mit zufälligem Schlüssel erzeugen: node scripts/install.mjs --init
# Danach eigene Werte setzen; diese Datei enthält ausschließlich Beispiele.
# Die lokale .env wird nicht in Git oder Plugin-ZIPs aufgenommen.
ENCRYPTION_KEY=
# Öffentlicher MCP-/Portal-Host (HTTPS-Origin ohne Pfad).
PUBLIC_URL=https://mcp.example.org
# Host-Port für Docker bzw. Port für den nativen Betrieb.
PORT=3000
DATABASE_PATH=data/gitea.sqlite
# OAuth/OIDC-Anbieter: echte Werte aus dessen Discovery übernehmen.
OAUTH_ISSUER=https://auth.example.org/realms/gitea
OAUTH_AUDIENCE=https://mcp.example.org/mcp
OAUTH_JWKS_URL=https://auth.example.org/realms/gitea/protocol/openid-connect/certs
OAUTH_AUTHORIZATION_URL=https://auth.example.org/realms/gitea/protocol/openid-connect/auth
OAUTH_TOKEN_URL=https://auth.example.org/realms/gitea/protocol/openid-connect/token
PORTAL_CLIENT_ID=gitea-portal
# Öffentliche OAuth-Client-ID des ChatGPT-/Codex-Clients; wird ins Plugin gebaut.
MCP_CLIENT_ID=gitea-chatgpt
# Eigene Gitea-Instanzen hier eintragen. Kein Gitea-Server ist vorkonfiguriert.
# Zugangsdaten im geschützten Portal hinterlegen, nicht im Chat.
# GITEA_INSTANCES=[{"id":"my-server","url":"https://YOUR-GITEA-HOST"}]
GITEA_INSTANCES=[]
# Vorgabe: Serverliste ausschließlich in .env konfigurieren.
# Optional true: öffentliche HTTPS-Gitea-Server im Browserportal zulassen.
ALLOW_USER_SERVERS=false
# Leer = nur öffentliche IPs. Interne Ziele bei Bedarf eng als CIDR freigeben.
ALLOWED_PRIVATE_CIDRS=
